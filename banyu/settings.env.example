# Banyu settings. Edit this file, save, then restart the server (stop with Ctrl+C, run: node server.js)
# Never share this file, never upload it, never paste its contents into a chat.

# Xendit SECRET key. Test mode: xnd_development_...   Live mode (later): xnd_production_...
# (NOT the "public" key. Dashboard > Settings > Developers > API Keys, Money-In = WRITE)
XENDIT_SECRET_KEY=

# Which payment methods Xendit's page offers. QRIS = customer scans with ANY bank app or e-wallet (BCA mobile, GoPay, OVO...).
# Other values: ALL (everything enabled on your Xendit account) or a list like QRIS,BCA
# QRIS must be enabled on your Xendit account; if it is not, the kiosk shows "Pembayaran belum tersedia" and the server prints why.
XENDIT_PAYMENT_METHODS=QRIS

# Dispenser (ESP32) web address, e.g. http://192.168.31.171   (see "ip" in http://<address>/api/status)
# Leave EMPTY until the dispenser is ready: then the tablet fakes the pour. This PC must be on the dispenser's Wi-Fi.
ESP32_BASE_URL=

# Optional tuning: seconds the tank must read LOW before an alert (default 20); seconds without reply before "offline" (default 30)
# TANK_LOW_SECONDS=20
# OFFLINE_SECONDS=30

# ---- Dashboard login (PLACEHOLDER) ----
# The dashboard only lets someone in if they type one of these keywords on the login page. Separate several with commas.
# There are no user accounts or database yet; anyone who knows a keyword gets in. Pick your own, keep it private,
# and restart the server after changing it. (If this line is missing, the default keyword is "banyu-admin".)
ADMIN_KEYWORDS=

# ---- Cold water estimator (first guesses, calibrate with a thermometer at the cold outlet) ----
# COLD_CAPACITY_ML=2000        size of the cold tank
# COLD_RECOVER_ML_MIN=22       how fast the chiller wins back cold water (2 L in about 1.5 hours)
# COLD_ABOVE_ML=1500           at or above this: "Cold". Below it: "Cool" (still colder than room temperature)
# COLD_LOCK_BELOW_ML=1000      below this: cold sales are blocked
# COLD_REENABLE_AT_ML=1250     cold sales come back at this level (higher than the lock line so the button does not flicker)
